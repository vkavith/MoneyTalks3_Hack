# Copy to .env. Never commit .env. Sandbox and test keys only.

# mock = fake payments inside the repo (default, no network)
# increase = Increase sandbox (lane 3 wires this up)
PAYMENT_PROVIDER=mock

# Increase SANDBOX key and source account. Never a production key.
INCREASE_API_KEY=
INCREASE_ACCOUNT_ID=
INCREASE_BASE_URL=https://sandbox.increase.com

# LLM key for the intake and exception agents
ANTHROPIC_API_KEY=

# Nicrron: OpenAI-compatible LLM gateway the agents call (one key, every model).
# Point the OpenAI SDK at NICRRON_BASE_URL with NICRRON_API_KEY; model names are
# provider-prefixed, e.g. anthropic/claude-sonnet-5-5. Ask Dylan for the key;
# it is revoked after the event.
NICRRON_API_KEY=
NICRRON_BASE_URL=https://api.nicrron.ai/v1
NICRRON_MODEL=anthropic/claude-sonnet-5-5

# Prism (Block Convey): guardrails and an audit trace for every payment decision.
# Lane 3 asks Prism's guardrails before paying and records approve/pay/reconcile.
# Ask Dylan for the key; it is revoked after the event. Project id comes from the key.
PRISMTRACE_HOST=https://api.prism.blockconvey.com
PRISMTRACE_PROJECT_ID=
PRISMTRACE_API_KEY=
