{
  "name": "ap-agent",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "seed": "tsx scripts/seed.ts",
    "check:data": "tsx scripts/check-data.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pipeline": "tsx apps/orchestrator/src/run.ts",
    "check": "npm run typecheck && npm run check:data && npm run pipeline"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.13.4",
    "pdfkit": "^0.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
